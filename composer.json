{
  "name": "coordinadora/legacy-incident-client",
  "description": "PHP client for incident integration with modern Coordinadora platform",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Jesus David Muñoz Gallego",
      "email": "davidgallego092@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Coordinadora\\Legacy\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Coordinadora\\Legacy\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-text --coverage-html=coverage/html",
    "phpstan": "phpstan analyse src/",
    "phpcbf": "phpcbf src/ --standard=PSR12",
    "phpcs": "phpcs src/ --standard=PSR12"
  }
}
