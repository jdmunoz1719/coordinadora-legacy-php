# Coordinadora Legacy Integration Configuration

# URL del API moderno (NestJS)
# Ejemplo: http://localhost:3001 (desarrollo)
INCIDENT_API_URL=http://localhost:3001

# Timeout en segundos para requests HTTP
# Rango: 1-300
INCIDENT_API_TIMEOUT=10

# Verificar certificado SSL en HTTPS
# IMPORTANTE: siempre true en producción
INCIDENT_VERIFY_SSL=true

# Nivel de logging: debug, info, warning, error
LOG_LEVEL=info

# Ruta del archivo de logs
# Asegúrese de que el directorio es escribible por el servidor web
LOG_PATH=/var/log/legacy-integration.log
